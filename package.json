{
  "name": "portfolio",
  "version": "0.1.0",
  "description": "Open-source, Cloudflare-native portfolio platform for QA/dev professionals — Astro + D1 + KV + R2",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview:cf": "wrangler pages dev dist --port 8788",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:smoke": "playwright test tests/smoke",
    "db:migrate": "wrangler d1 migrations apply portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "deploy": "astro build && wrangler pages deploy dist --project-name=portfolio",
    "deploy:sync-worker": "wrangler deploy --config workers/wrangler.toml",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^12.6.13",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^3.2.7",
    "astro": "^5.18.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.149.0",
    "zod": "^3.25.76"
  }
}
