---
import { siteConfig } from '../../../config/site.config';
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker">Foundations</p>
      <h2 class="section-title" id="education-title">
        Education & certifications
      </h2>
    </div>
    <ul class="edu-list">
      {siteConfig.education.map((entry) => (
        <li class="edu-item">
          <strong>{entry.institution}</strong>
          {entry.degree && <span aria-hidden="true">·</span>}
          {entry.degree && <em>{entry.degree}</em>}
          {entry.period && <span>{entry.period}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>
