---
import { siteConfig } from '../../../config/site.config';

const { pov } = siteConfig;
---

<section id="pov" class="section" aria-labelledby="pov-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{pov.kicker ?? 'Point of view'}</p>
      <h2 class="section-title" id="pov-title">
        {pov.title}
      </h2>
    </div>
    <div class="prose">
      {pov.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>
