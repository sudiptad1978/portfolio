---
import { siteConfig } from '../../../config/site.config';

const columns = [
  { title: 'Domains', items: siteConfig.snapshot.domains },
  { title: 'Languages', items: siteConfig.snapshot.languages },
  { title: 'Tools', items: siteConfig.snapshot.tools },
].filter((column) => column.items.length > 0);
---

<section id="snapshot" class="section" aria-labelledby="snapshot-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker">Career snapshot</p>
      <h2 class="section-title" id="snapshot-title">
        At a glance
      </h2>
    </div>
    <div class="snapshot-grid">
      {columns.map((column) => (
        <div class="snapshot-col">
          <h3>{column.title}</h3>
          <ul>
            {column.items.map((item) => (
              <li>
                <span class="chip">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
