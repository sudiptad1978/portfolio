---
import { siteConfig } from '../../../config/site.config';

const icons: Record<string, string> = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  gauge: '<path d="M12 14 15.5 8.5"/><path d="M20.5 14a8.5 8.5 0 1 0-17 0"/>',
  pipeline:
    '<circle cx="5" cy="6" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M5 8.5v3a4 4 0 0 0 4 4h6a4 4 0 0 1 3.5 2"/>',
  layers:
    '<path d="m12 2 10 5-10 5L2 7l10-5z"/><path d="m2 12 10 5 10-5"/><path d="m2 17 10 5 10-5"/>',
};
---

<section id="capabilities" class="section" aria-labelledby="capabilities-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker">What I bring</p>
      <h2 class="section-title" id="capabilities-title">
        Capabilities
      </h2>
    </div>
    <div class="cards">
      {siteConfig.capabilities.map((capability) => (
        <article class="card">
          {capability.icon && (
            <div class="card-icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[capability.icon] ?? icons.layers}
              />
            </div>
          )}
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
