---
import { siteConfig } from '../../config/site.config';

const socials = siteConfig.social.filter((s) => s.platform !== 'email');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      © {year} {siteConfig.name} · Built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">
        Astro
      </a>{' '}
      +
      <a href="https://developers.cloudflare.com/pages/" target="_blank" rel="noopener noreferrer">
        Cloudflare Pages
      </a>
    </div>
    <div class="footer-social">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.label ?? social.platform}
        >
          {social.platform}
        </a>
      ))}
      {siteConfig.repoUrl && (
        <a href={siteConfig.repoUrl} target="_blank" rel="noopener noreferrer">
          Fork this template ↗
        </a>
      )}
    </div>
  </div>
</footer>
